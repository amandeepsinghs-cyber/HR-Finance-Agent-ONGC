FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    UV_COMPILE_BYTECODE=1

# Install Node.js 20, curl, Pango/HarfBuzz (P4.6 WeasyPrint PDF shaping), and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg \
    libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 \
    libharfbuzz0b libharfbuzz-subset0 shared-mime-info && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    pip install --no-cache-dir uv && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Install Python backend dependencies
COPY yukti/backend/pyproject.toml yukti/backend/uv.lock /app/yukti/backend/
RUN cd /app/yukti/backend && uv sync --frozen --no-dev --no-install-project && uv pip install pyarrow pandas

# 2. Install Frontend dependencies from public npm registry (strip corp airlock package-lock.json)
COPY yukti/frontend/package.json /app/yukti/frontend/package.json
RUN cd /app/yukti/frontend && \
    rm -f package-lock.json .npmrc && \
    npm install --registry=https://registry.npmjs.org --no-package-lock --no-audit --no-fund

# 3. Copy application code, contracts, and lightweight answer-key/template metadata
COPY yukti/contracts /app/yukti/contracts
COPY yukti/backend /app/yukti/backend
COPY yukti/frontend /app/yukti/frontend
COPY data_bank/answer_key /app/data_bank/answer_key
COPY data_bank/world_bible/reference /app/data_bank/world_bible/reference
COPY data_bank/landing/documents/rulebooks_clause_index.csv /app/data_bank/landing/documents/rulebooks_clause_index.csv
COPY data_bank/landing/documents/templates /app/data_bank/landing/documents/templates
# P0.9 (BUG-13 part): runtime financial snapshot read by the backend (compiler local_snapshot fallback,
# insight context, notes corpus). BigQuery stays primary; on an outage answers carry the "Local snapshot" badge.
COPY financial_build/data/ongc_10yr_schedule_iii_lines.json \
     financial_build/data/ongc_10yr_balance_sheet_lines.json \
     financial_build/data/ongc_10yr_cash_flow_lines.json \
     financial_build/data/ongc_10yr_ratios_lines.json \
     financial_build/data/ongc_10yr_corporate_wide.json \
     financial_build/data/snapshot_manifest.json \
     /app/financial_build/data/
COPY financial_ssot/out/fact_snapshot.parquet /app/financial_ssot/out/fact_snapshot.parquet
COPY financial_ssot/dim_financial_line.csv /app/financial_ssot/dim_financial_line.csv
COPY start_cloudrun.sh /app/start_cloudrun.sh

# H1.5a: tokens are generated by `prebuild`; type-check + token/contrast lint gate the image build
RUN chmod +x /app/start_cloudrun.sh && \
    cd /app/yukti/frontend && \
    rm -f package-lock.json .npmrc && \
    npm run lint:tokens && npm run lint:contrast && \
    npx tsc --noEmit -p . && \
    npm run build

ENV NODE_ENV=production \
    YUKTI_PLANNER=1 \
    YUKTI_ENV=prod \
    YUKTI_AUTH_MODE=demo
# YUKTI_AUTH_MODE=demo lets anyone who can reach the service start a CMD session: acceptable only while the Cloud Run
# service stays IAM-protected. Switch to YUKTI_AUTH_MODE=iap at P5.6 (SPEC-06 §4.4).
# P0.4/P0.5 runtime settings (never baked into the image):
#   --set-secrets YUKTI_PERSONA_SIGNING_KEY=<secret>:latest   (required, >= 32 bytes: signs persona session tokens;
#                                                              with YUKTI_ENV=prod a missing/short key fails closed:
#                                                              startup logs an error and every protected route -> 401)
#   --set-secrets YUKTI_DEMO_ADMIN_PASSPHRASE=<secret>:latest (optional: enables the DEMO_ADMIN presenter)
#   YUKTI_ALLOWED_ORIGINS=https://<service-url>               (the UI is same-origin; list only real callers;
#                                                              unset in prod -> no cross-origin callers allowed)
#   YUKTI_ENABLE_ADMIN stays unset on Cloud Run (/admin/* -> 404)
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD curl -sf http://127.0.0.1:${PORT:-8080}/health || exit 1
CMD ["/app/start_cloudrun.sh"]
