{
  "name": "yukti-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/gen_tokens.mjs",
    "predev": "npm run tokens",
    "dev": "node server.js --dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "lint:tokens": "node scripts/check_tokens.mjs",
    "typecheck": "tsc --noEmit",
    "build:fixtures": "python3 scripts/build_fixtures.py",
    "check:fixtures": "python3 scripts/check_fixtures.py",
    "test:smoke": "node scripts/smoke_test.js",
    "test:live": "node scripts/live_e2e_test.js",
    "test:voice": "node scripts/voice_e2e_test.js",
    "test:visual": "node scripts/visual_capture.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "echarts": "^5.5.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "playwright": "^1.48.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
