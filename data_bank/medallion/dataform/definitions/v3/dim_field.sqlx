config {
  type: "table",
  schema: "hrfin_gold",
  name: "dim_field_v3",
  description: "Field dimension for Field Economics-360"
}

SELECT
  field_id,
  name AS field_name,
  basin AS basin_name,
  asset_wc_id,
  CAST(NULL AS STRING) AS state_code,
  onshore_offshore,
  maturity AS field_category,
  hydrocarbon AS hydrocarbon_type,
  discovery_year
FROM ${ref(dataform.projectConfig.schemaSuffix ? "hrfin_silver_" + dataform.projectConfig.schemaSuffix : "hrfin_silver", "dim_field")}
