config {
  type: "view",
  schema: "hrfin_gold",
  name: "v_employee_360_fy",
  description: "FY rolled up view."
}
SELECT
  emp_id,
  fiscal_year,
  COUNT(*) AS months_on_roll,
  LOGICAL_OR(is_month_end_active) AS is_month_end_active,
  LOGICAL_OR(separated_in_month_flag) AS separated_in_fy,
  LOGICAL_OR(joined_in_month_flag) AS joined_in_fy,
  SUM(pay_scale_min_inr) AS pay_scale_min_inr,
  SUM(pay_scale_max_inr) AS pay_scale_max_inr,
  SUM(basic_pay_inr) AS basic_pay_inr,
  SUM(ida_inr) AS ida_inr,
  SUM(hra_inr) AS hra_inr,
  SUM(cafeteria_allowance_inr) AS cafeteria_allowance_inr,
  SUM(caf_conveyance_inr) AS caf_conveyance_inr,
  SUM(caf_children_edu_inr) AS caf_children_edu_inr,
  SUM(caf_professional_dev_inr) AS caf_professional_dev_inr,
  SUM(caf_other_perks_inr) AS caf_other_perks_inr,
  SUM(hardship_offshore_inr) AS hardship_offshore_inr,
  SUM(field_duty_allowance_inr) AS field_duty_allowance_inr,
  SUM(location_comp_allowance_inr) AS location_comp_allowance_inr,
  SUM(hard_station_allowance_inr) AS hard_station_allowance_inr,
  SUM(shift_allowance_inr) AS shift_allowance_inr,
  SUM(night_duty_allowance_inr) AS night_duty_allowance_inr,
  SUM(npa_inr) AS npa_inr,
  SUM(special_allowance_inr) AS special_allowance_inr,
  SUM(overtime_hours) AS overtime_hours,
  SUM(overtime_amount_inr) AS overtime_amount_inr,
  SUM(prp_accrual_inr) AS prp_accrual_inr,
  SUM(prp_paid_inr) AS prp_paid_inr,
  SUM(arrears_inr) AS arrears_inr,
  SUM(leave_encashment_paid_inr) AS leave_encashment_paid_inr,
  SUM(ltc_inr) AS ltc_inr,
  SUM(medical_reimbursement_inr) AS medical_reimbursement_inr,
  SUM(ex_gratia_other_inr) AS ex_gratia_other_inr,
  SUM(gross_earnings_inr) AS gross_earnings_inr,
  SUM(employer_cpf_inr) AS employer_cpf_inr,
  SUM(employer_prbs_inr) AS employer_prbs_inr,
  SUM(gratuity_accrual_inr) AS gratuity_accrual_inr,
  SUM(employer_prmb_inr) AS employer_prmb_inr,
  SUM(csss_contribution_inr) AS csss_contribution_inr,
  SUM(superannuation_total_inr) AS superannuation_total_inr,
  SUM(leave_provision_accrual_inr) AS leave_provision_accrual_inr,
  SUM(medical_scheme_cost_inr) AS medical_scheme_cost_inr,
  SUM(group_insurance_premium_inr) AS group_insurance_premium_inr,
  SUM(accident_insurance_premium_inr) AS accident_insurance_premium_inr,
  SUM(housing_cost_inr) AS housing_cost_inr,
  SUM(canteen_subsidy_inr) AS canteen_subsidy_inr,
  SUM(transport_subsidy_inr) AS transport_subsidy_inr,
  SUM(staff_welfare_alloc_inr) AS staff_welfare_alloc_inr,
  SUM(training_cost_inr) AS training_cost_inr,
  SUM(employer_cost_noncash_inr) AS employer_cost_noncash_inr,
  SUM(employee_pf_inr) AS employee_pf_inr,
  SUM(vpf_inr) AS vpf_inr,
  SUM(tds_inr) AS tds_inr,
  SUM(professional_tax_inr) AS professional_tax_inr,
  SUM(hrr_recovery_inr) AS hrr_recovery_inr,
  SUM(loan_recoveries_inr) AS loan_recoveries_inr,
  SUM(other_recoveries_inr) AS other_recoveries_inr,
  SUM(total_deductions_inr) AS total_deductions_inr,
  SUM(net_pay_inr) AS net_pay_inr,
  SUM(ctc_monthly_inr) AS ctc_monthly_inr,
  SUM(ctc_annualised_inr) AS ctc_annualised_inr,
  SUM(cost_note35_a_inr) AS cost_note35_a_inr,
  SUM(cost_note35_b_inr) AS cost_note35_b_inr,
  SUM(cost_note35_c_inr) AS cost_note35_c_inr,
  SUM(cost_note35_d_inr) AS cost_note35_d_inr,
  SUM(cost_note35_e_inr) AS cost_note35_e_inr,
  SUM(cost_note35_f_inr) AS cost_note35_f_inr,
  SUM(cost_total_inr) AS cost_total_inr,
  SUM(cost_total_inr) AS cost_total_fy,
  SUM(cost_capitalised_inr) AS cost_capitalised_inr,
  SUM(cost_expensed_inr) AS cost_expensed_inr,
  SUM(cost_expensed_production_inr) AS cost_expensed_production_inr,
  SUM(cost_expensed_gae_inr) AS cost_expensed_gae_inr,
  SUM(cost_expensed_exploration_inr) AS cost_expensed_exploration_inr,
  SUM(el_balance_days) AS el_balance_days,
  SUM(hpl_balance_days) AS hpl_balance_days,
  SUM(cl_balance_days) AS cl_balance_days,
  SUM(el_availed_days) AS el_availed_days,
  SUM(hpl_availed_days) AS hpl_availed_days,
  SUM(cl_availed_days) AS cl_availed_days,
  SUM(other_leave_days) AS other_leave_days,
  SUM(el_encashable_days) AS el_encashable_days,
  SUM(working_days) AS working_days,
  SUM(unauthorised_absence_days) AS unauthorised_absence_days,
  SUM(scheduled_hours) AS scheduled_hours,
  SUM(offshore_days) AS offshore_days,
  SUM(training_hours) AS training_hours,
  MAX_BY(fy_month_no, month_start) AS fy_month_no,
  MAX_BY(roll_status, month_start) AS roll_status,
  MAX_BY(days_on_roll, month_start) AS days_on_roll,
  MAX_BY(data_label, month_start) AS data_label,
  MAX_BY(build_run_id, month_start) AS build_run_id,
  MAX_BY(full_name, month_start) AS full_name,
  MAX_BY(first_name, month_start) AS first_name,
  MAX_BY(last_name, month_start) AS last_name,
  MAX_BY(gender, month_start) AS gender,
  MAX_BY(date_of_birth, month_start) AS date_of_birth,
  MAX_BY(age_years, month_start) AS age_years,
  MAX_BY(age_band_brsr, month_start) AS age_band_brsr,
  MAX_BY(age_band_10y, month_start) AS age_band_10y,
  MAX_BY(social_category, month_start) AS social_category,
  MAX_BY(pwd_flag, month_start) AS pwd_flag,
  MAX_BY(ex_serviceman_flag, month_start) AS ex_serviceman_flag,
  MAX_BY(home_state_code, month_start) AS home_state_code,
  MAX_BY(marital_status, month_start) AS marital_status,
  MAX_BY(dependants_count, month_start) AS dependants_count,
  MAX_BY(grade_id, month_start) AS grade_id,
  MAX_BY(grade_level_order, month_start) AS grade_level_order,
  MAX_BY(cadre, month_start) AS cadre,
  MAX_BY(group_class, month_start) AS group_class,
  MAX_BY(grade_designation, month_start) AS grade_designation,
  MAX_BY(functional_designation, month_start) AS functional_designation,
  MAX_BY(discipline_id, month_start) AS discipline_id,
  MAX_BY(discipline_name, month_start) AS discipline_name,
  MAX_BY(function_code, month_start) AS function_code,
  MAX_BY(department, month_start) AS department,
  MAX_BY(section, month_start) AS section,
  MAX_BY(wc_id, month_start) AS wc_id,
  MAX_BY(wc_name, month_start) AS wc_name,
  MAX_BY(wc_type, month_start) AS wc_type,
  MAX_BY(asset_id, month_start) AS asset_id,
  MAX_BY(basin_id, month_start) AS basin_id,
  MAX_BY(field_id, month_start) AS field_id,
  MAX_BY(location_type, month_start) AS location_type,
  MAX_BY(offshore_rotation_flag, month_start) AS offshore_rotation_flag,
  MAX_BY(hard_station_flag, month_start) AS hard_station_flag,
  MAX_BY(city_name, month_start) AS city_name,
  MAX_BY(state_of_posting, month_start) AS state_of_posting,
  MAX_BY(city_class_hra, month_start) AS city_class_hra,
  MAX_BY(lca_zone, month_start) AS lca_zone,
  MAX_BY(reporting_manager_emp_id, month_start) AS reporting_manager_emp_id,
  MAX_BY(direct_reports_count, month_start) AS direct_reports_count,
  MAX_BY(cost_centre_id, month_start) AS cost_centre_id,
  MAX_BY(profit_centre_id, month_start) AS profit_centre_id,
  MAX_BY(cost_destination, month_start) AS cost_destination,
  MAX_BY(union_member_flag, month_start) AS union_member_flag,
  MAX_BY(doj, month_start) AS doj,
  MAX_BY(entry_mode, month_start) AS entry_mode,
  MAX_BY(entry_grade, month_start) AS entry_grade,
  MAX_BY(total_service_years, month_start) AS total_service_years,
  MAX_BY(grade_since, month_start) AS grade_since,
  MAX_BY(grade_tenure_years, month_start) AS grade_tenure_years,
  MAX_BY(last_promotion_date, month_start) AS last_promotion_date,
  MAX_BY(promotions_count, month_start) AS promotions_count,
  MAX_BY(current_station_since, month_start) AS current_station_since,
  MAX_BY(station_tenure_continuous_years, month_start) AS station_tenure_continuous_years,
  MAX_BY(station_tenure_cumulative_years, month_start) AS station_tenure_cumulative_years,
  MAX_BY(cluster_tenure_cumulative_years, month_start) AS cluster_tenure_cumulative_years,
  MAX_BY(last_transfer_date, month_start) AS last_transfer_date,
  MAX_BY(transfers_count, month_start) AS transfers_count,
  MAX_BY(transfer_due_flag, month_start) AS transfer_due_flag,
  MAX_BY(jrtp_exemption_code, month_start) AS jrtp_exemption_code,
  MAX_BY(exemption_valid_until, month_start) AS exemption_valid_until,
  MAX_BY(superannuation_date, month_start) AS superannuation_date,
  MAX_BY(years_to_superannuation, month_start) AS years_to_superannuation,
  MAX_BY(retiring_within_1y, month_start) AS retiring_within_1y,
  MAX_BY(_3y, month_start) AS _3y,
  MAX_BY(_5y, month_start) AS _5y,
  MAX_BY(pay_scale_version, month_start) AS pay_scale_version,
  MAX_BY(increments_count, month_start) AS increments_count,
  MAX_BY(stagnation_increments, month_start) AS stagnation_increments,
  MAX_BY(ida_pct, month_start) AS ida_pct,
  MAX_BY(hra_rate_pct, month_start) AS hra_rate_pct,
  MAX_BY(accommodation_type, month_start) AS accommodation_type,
  MAX_BY(superannuation_pct_bp_da, month_start) AS superannuation_pct_bp_da,
  MAX_BY(superannuation_cap_ok, month_start) AS superannuation_cap_ok,
  MAX_BY(capitalised_share, month_start) AS capitalised_share,
  MAX_BY(days_present, month_start) AS days_present,
  MAX_BY(training_hours_fytd, month_start) AS training_hours_fytd,
  MAX_BY(mandatory_training_done, month_start) AS mandatory_training_done,
  MAX_BY(apar_fy, month_start) AS apar_fy,
  MAX_BY(apar_grade, month_start) AS apar_grade,
  MAX_BY(apar_score, month_start) AS apar_score,
  MAX_BY(dpc_eligible_flag, month_start) AS dpc_eligible_flag,
  MAX_BY(dpc_due_date, month_start) AS dpc_due_date,
  MAX_BY(promoted_in_month_flag, month_start) AS promoted_in_month_flag,
  MAX_BY(promotion_from_grade, month_start) AS promotion_from_grade,
  MAX_BY(succession_pool_flag, month_start) AS succession_pool_flag,
  MAX_BY(recruitment_fy, month_start) AS recruitment_fy,
  MAX_BY(recruitment_channel, month_start) AS recruitment_channel,
  MAX_BY(separation_date, month_start) AS separation_date,
  MAX_BY(separation_type, month_start) AS separation_type,
  MAX_BY(separation_reason_detail, month_start) AS separation_reason_detail,
  MAX_BY(is_attrition, month_start) AS is_attrition,
  MAX_BY(delhi_overdue_flag, month_start) AS delhi_overdue_flag,
  MAX_BY(is_persona_identity, month_start) AS is_persona_identity,
  MAX_BY(dq_flags, month_start) AS dq_flags
FROM ${ref('ssot_employee_360')}
GROUP BY emp_id, fiscal_year
