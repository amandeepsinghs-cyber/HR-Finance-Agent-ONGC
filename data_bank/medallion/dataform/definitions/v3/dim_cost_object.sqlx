config {
  type: "table",
  schema: "hrfin_gold",
  name: "dim_cost_object",
  description: "Cost objects dimension (53 nomination fields, 4 JV shares, 3 VAP plants, 9 exploration basins, CO-HQ, CO-FIN, CO-TREASURY)"
}

