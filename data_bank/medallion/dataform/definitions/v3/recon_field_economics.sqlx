    'Capex' AS metric,
    CAST(fld_agg.capex AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('CAPEX' AS STRING) AS reference_line_code,
