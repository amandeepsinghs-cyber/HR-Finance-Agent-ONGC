  LEFT JOIN fld_agg ON fys.fiscal_year = fld_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'CAPEX'
  UNION ALL
  SELECT
    'FLD-R14' AS check_id,
    'SPEC-05' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Month Sum' AS metric,
    CAST(fld_agg.sum AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('SUM' AS STRING) AS reference_line_code,
    CAST((fld_agg.sum) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((fld_agg.sum) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.01 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS((fld_agg.sum) - IFNULL(t.reference_value, 0)) <= 0.01 OR 
        ABS(SAFE_DIVIDE((fld_agg.sum) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN fld_agg ON fys.fiscal_year = fld_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'SUM'
  UNION ALL
  SELECT
    'FLD-R15' AS check_id,
    'SPEC-05' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Negative' AS metric,
    CAST(fld_agg.neg AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('NEG' AS STRING) AS reference_line_code,
    CAST((fld_agg.neg) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((fld_agg.neg) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS((fld_agg.neg) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((fld_agg.neg) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN fld_agg ON fys.fiscal_year = fld_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'NEG'
  UNION ALL
  SELECT
    'FLD-R16' AS check_id,
    'SPEC-05' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Price' AS metric,
    CAST(fld_agg.price AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('PRICE' AS STRING) AS reference_line_code,
    CAST((fld_agg.price) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((fld_agg.price) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.03 AS NUMERIC) AS tolerance_pct,
    'WARN' AS severity,
    IF(TRUE, 
      IF(
        ABS((fld_agg.price) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((fld_agg.price) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.03, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN fld_agg ON fys.fiscal_year = fld_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'PRICE'
  UNION ALL
  SELECT
    'FLD-R17' AS check_id,
    'SPEC-05' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Opex Rank' AS metric,
    CAST(fld_agg.rank AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('RANK' AS STRING) AS reference_line_code,
    CAST((fld_agg.rank) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((fld_agg.rank) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'WARN' AS severity,
    IF(TRUE, 
      IF(
        ABS((fld_agg.rank) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((fld_agg.rank) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN fld_agg ON fys.fiscal_year = fld_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'RANK'
)
SELECT * FROM checks
