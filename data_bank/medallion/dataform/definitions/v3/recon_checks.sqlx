config {
  type: "incremental",
  schema: "hrfin_gold",
  name: "recon_checks",
  uniqueKey: ["run_id", "check_id", "fiscal_year", "level", "dimension_key", "metric"]
}

SELECT GENERATE_UUID() AS run_id, CURRENT_TIMESTAMP() AS run_ts, *
FROM (
  SELECT * FROM ${ref("recon_employee360")}
  UNION ALL
  SELECT * FROM ${ref("recon_field_economics")}
)
