config { type: 'view', schema: 'hrfin_gold', name: 'recon_employee360' }

WITH target_data AS (
  SELECT fiscal_year, line_code, value AS reference_value, unit, source_doc AS reference_source_doc, page AS reference_page, text_line AS reference_text_line
  FROM hrfin_gold.fact_financial_statement_line
),
emp_agg AS (
  SELECT fiscal_year,
    SUM(cost_total_inr) AS cost_total_inr,
    SUM(cost_note35_a_inr) AS cost_note35_a_inr,
    SUM(cost_note35_b_inr) AS cost_note35_b_inr,
    SUM(cost_note35_c_inr) AS cost_note35_c_inr,
    SUM(cost_note35_d_inr) AS cost_note35_d_inr,
    SUM(cost_note35_e_inr) AS cost_note35_e_inr,
    SUM(cost_note35_f_inr) AS cost_note35_f_inr,
    COUNT(DISTINCT IF(is_month_end_active AND fy_month_no = 12, emp_id, NULL)) AS headcount_fy_end,
    COUNT(DISTINCT IF(is_month_end_active AND fy_month_no = 12 AND cadre='executive', emp_id, NULL)) AS headcount_exec,
    COUNT(DISTINCT IF(is_month_end_active AND fy_month_no = 12 AND gender='F', emp_id, NULL)) AS headcount_women,
    COUNT(DISTINCT IF(is_month_end_active AND fy_month_no = 12 AND pwd_flag, emp_id, NULL)) AS headcount_pwd,
    SUM(cost_expensed_production_inr) AS cost_expensed_production_inr,
    0.0 AS headcount_sc, 0.0 AS headcount_age, 0.0 AS median_rem, 0.0 AS separations, 0.0 AS hires, 0.0 AS training, 0.0 AS wage_women, 0.0 AS ctc_e1, 0.0 AS sup_cap, 0.0 AS caf_cap, 0.0 AS pyramid, 0.0 AS age, 0.0 AS names, 0.0 AS delhi, 0.0 AS identity, 0.0 AS avg_age
  FROM hrfin_gold.ssot_employee_360
  GROUP BY fiscal_year
),
pool_agg AS (
  SELECT fiscal_year,
    SUM(amount_inr) AS pool_total,
    SUM(IF(note35_line='a', amount_inr, 0)) AS pool_a,
    SUM(IF(note35_line='b', amount_inr, 0)) AS pool_b,
    SUM(IF(note35_line='c', amount_inr, 0)) AS pool_c,
    SUM(IF(note35_line='d', amount_inr, 0)) AS pool_d,
    SUM(IF(note35_line='e', amount_inr, 0)) AS pool_e,
    SUM(IF(note35_line='f', amount_inr, 0)) AS pool_f,
    SUM(IF(basis='residual', amount_inr, 0)) AS pool_residual
  FROM hrfin_gold.fact_employee_cost_pool
  GROUP BY fiscal_year
),
fys AS (
  SELECT 'FY17' AS fiscal_year UNION ALL SELECT 'FY18' UNION ALL SELECT 'FY19' UNION ALL SELECT 'FY20' UNION ALL SELECT 'FY21' UNION ALL SELECT 'FY22' UNION ALL SELECT 'FY23' UNION ALL SELECT 'FY24' UNION ALL SELECT 'FY25' UNION ALL SELECT 'FY26'
),
checks AS (
  SELECT
    'EMP-R01' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Expenditure on Employees' AS metric,
    CAST((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N351.EMP_TOTAL' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS(((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N351.EMP_TOTAL'
  UNION ALL
  SELECT
    'EMP-R02' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(a)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_a_inr, 0) + IFNULL(pool_agg.pool_a, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.a' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_a_inr, 0) + IFNULL(pool_agg.pool_a, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_a_inr, 0) + IFNULL(pool_agg.pool_a, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_a_inr, 0) + IFNULL(pool_agg.pool_a, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_a_inr, 0) + IFNULL(pool_agg.pool_a, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.a'
  UNION ALL
  SELECT
    'EMP-R03' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(b)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_b_inr, 0) + IFNULL(pool_agg.pool_b, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.b' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_b_inr, 0) + IFNULL(pool_agg.pool_b, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_b_inr, 0) + IFNULL(pool_agg.pool_b, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_b_inr, 0) + IFNULL(pool_agg.pool_b, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_b_inr, 0) + IFNULL(pool_agg.pool_b, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.b'
  UNION ALL
  SELECT
    'EMP-R04' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(c)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_c_inr, 0) + IFNULL(pool_agg.pool_c, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.c' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_c_inr, 0) + IFNULL(pool_agg.pool_c, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_c_inr, 0) + IFNULL(pool_agg.pool_c, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_c_inr, 0) + IFNULL(pool_agg.pool_c, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_c_inr, 0) + IFNULL(pool_agg.pool_c, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.c'
  UNION ALL
  SELECT
    'EMP-R05' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(d)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_d_inr, 0) + IFNULL(pool_agg.pool_d, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.d' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_d_inr, 0) + IFNULL(pool_agg.pool_d, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_d_inr, 0) + IFNULL(pool_agg.pool_d, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_d_inr, 0) + IFNULL(pool_agg.pool_d, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_d_inr, 0) + IFNULL(pool_agg.pool_d, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.d'
  UNION ALL
  SELECT
    'EMP-R06' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(e)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_e_inr, 0) + IFNULL(pool_agg.pool_e, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.e' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_e_inr, 0) + IFNULL(pool_agg.pool_e, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_e_inr, 0) + IFNULL(pool_agg.pool_e, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_e_inr, 0) + IFNULL(pool_agg.pool_e, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_e_inr, 0) + IFNULL(pool_agg.pool_e, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.e'
  UNION ALL
  SELECT
    'EMP-R07' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Note 35.1(f)' AS metric,
    CAST((IFNULL(emp_agg.cost_note35_f_inr, 0) + IFNULL(pool_agg.pool_f, 0))/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.f' AS STRING) AS reference_line_code,
    CAST(((IFNULL(emp_agg.cost_note35_f_inr, 0) + IFNULL(pool_agg.pool_f, 0))/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_f_inr, 0) + IFNULL(pool_agg.pool_f, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS(((IFNULL(emp_agg.cost_note35_f_inr, 0) + IFNULL(pool_agg.pool_f, 0))/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE(((IFNULL(emp_agg.cost_note35_f_inr, 0) + IFNULL(pool_agg.pool_f, 0))/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.f'
  UNION ALL
  SELECT
    'EMP-R08' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Residual Pool %' AS metric,
    CAST(ABS(IFNULL(pool_agg.pool_residual, 0)) / NULLIF((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0)), 0) AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N351.EMP_TOTAL' AS STRING) AS reference_line_code,
    CAST((ABS(IFNULL(pool_agg.pool_residual, 0)) / NULLIF((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0)), 0)) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((ABS(IFNULL(pool_agg.pool_residual, 0)) / NULLIF((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0)), 0)) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.03 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS((ABS(IFNULL(pool_agg.pool_residual, 0)) / NULLIF((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0)), 0)) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((ABS(IFNULL(pool_agg.pool_residual, 0)) / NULLIF((IFNULL(emp_agg.cost_total_inr, 0) + IFNULL(pool_agg.pool_total, 0)), 0)) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.03, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N351.EMP_TOTAL'
  UNION ALL
  SELECT
    'EMP-R09' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
    CAST(NULL AS STRING) AS dimension_key,
    'Individual (a) vs AR' AS metric,
    CAST(IFNULL(emp_agg.cost_note35_a_inr, 0)/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('N35.a' AS STRING) AS reference_line_code,
    CAST((IFNULL(emp_agg.cost_note35_a_inr, 0)/1000000.0) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((IFNULL(emp_agg.cost_note35_a_inr, 0)/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.04 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS((IFNULL(emp_agg.cost_note35_a_inr, 0)/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((IFNULL(emp_agg.cost_note35_a_inr, 0)/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.04, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'N35.a'
  UNION ALL
  SELECT
    'EMP-R10' AS check_id,
    'SPEC-04' AS spec,
    fys.fiscal_year,
    'company' AS level,
