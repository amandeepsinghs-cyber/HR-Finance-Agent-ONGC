    CAST(SAFE_DIVIDE((emp_agg.identity) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.01 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS((emp_agg.identity) - IFNULL(t.reference_value, 0)) <= 0.01 OR 
        ABS(SAFE_DIVIDE((emp_agg.identity) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
