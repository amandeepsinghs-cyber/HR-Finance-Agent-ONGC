    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.05 AS NUMERIC) AS tolerance_pct,
    'WARN' AS severity,
    IF(TRUE, 
      IF(
        ABS((emp_agg.delhi) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
