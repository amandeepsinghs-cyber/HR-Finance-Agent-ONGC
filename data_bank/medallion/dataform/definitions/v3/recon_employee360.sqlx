  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'AGE'
  UNION ALL
  SELECT
