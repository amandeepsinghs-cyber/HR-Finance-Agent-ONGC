    CAST(SAFE_DIVIDE((emp_agg.pyramid) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
