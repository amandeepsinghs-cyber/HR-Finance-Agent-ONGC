    CAST(SAFE_DIVIDE((emp_agg.avg_age) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(1.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'WARN' AS severity,
    IF(TRUE, 
      IF(
        ABS((emp_agg.avg_age) - IFNULL(t.reference_value, 0)) <= 1.0 OR 
        ABS(SAFE_DIVIDE((emp_agg.avg_age) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
