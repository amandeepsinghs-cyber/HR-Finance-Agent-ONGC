    'Production Expensed' AS metric,
    CAST(emp_agg.cost_expensed_production_inr/1000000.0 AS NUMERIC) AS ssot_value,
    CAST(IFNULL(t.reference_value, 0) AS NUMERIC) AS reference_value,
    CAST(IFNULL(t.unit, 'unit') AS STRING) AS unit,
    CAST(IFNULL(t.reference_source_doc, 'doc') AS STRING) AS reference_source_doc,
