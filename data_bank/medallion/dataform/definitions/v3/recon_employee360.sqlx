    CAST(IFNULL(t.reference_page, 1) AS INT64) AS reference_page,
    CAST(IFNULL(t.reference_text_line, 1) AS INT64) AS reference_text_line,
    CAST('CAP.CAF' AS STRING) AS reference_line_code,
    CAST((emp_agg.caf_cap) - IFNULL(t.reference_value, 0) AS NUMERIC) AS delta,
    CAST(SAFE_DIVIDE((emp_agg.caf_cap) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1)) AS NUMERIC) AS delta_pct,
    CAST(0.0 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(TRUE, 
      IF(
        ABS((emp_agg.caf_cap) - IFNULL(t.reference_value, 0)) <= 0.0 OR 
        ABS(SAFE_DIVIDE((emp_agg.caf_cap) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
        'PASS', 'FAIL'
      ),
      'NOT_AVAILABLE'
    ) AS status,
    '' AS notes
  FROM fys
  LEFT JOIN emp_agg ON fys.fiscal_year = emp_agg.fiscal_year
  LEFT JOIN pool_agg ON fys.fiscal_year = pool_agg.fiscal_year
  LEFT JOIN target_data t ON fys.fiscal_year = t.fiscal_year AND t.line_code = 'CAP.CAF'
  UNION ALL
  SELECT
