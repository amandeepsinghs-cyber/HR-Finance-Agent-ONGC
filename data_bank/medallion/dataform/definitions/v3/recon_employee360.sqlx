    CAST(0.1 AS NUMERIC) AS tolerance_abs,
    CAST(0.0 AS NUMERIC) AS tolerance_pct,
    'BLOCK' AS severity,
    IF(fys.fiscal_year IN ('FY21','FY22','FY23','FY24','FY25','FY26'), 
      IF(
        ABS((emp_agg.cost_expensed_production_inr/1000000.0) - IFNULL(t.reference_value, 0)) <= 0.1 OR 
        ABS(SAFE_DIVIDE((emp_agg.cost_expensed_production_inr/1000000.0) - IFNULL(t.reference_value, 0), IFNULL(t.reference_value, 1))) <= 0.0, 
