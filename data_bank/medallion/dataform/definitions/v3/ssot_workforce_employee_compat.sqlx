config {
  type: "view",
  schema: "hrfin_gold",
  name: "ssot_workforce_employee",
  description: "Compat view."
}
SELECT
  emp_id AS emp_id,
  stay AS stay,
  v_continuous_stay` AS v_continuous_stay`,
  WHERE is_current_stay = TRUE AS WHERE is_current_stay = TRUE,
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  ( AS (,
  SELECT AS SELECT,
  emp_id AS emp_id,
  cl AS cl,
  v_cluster_cumulative_tenure` AS v_cluster_cumulative_tenure`,
  WHERE is_currently_in_cluster = TRUE AS WHERE is_currently_in_cluster = TRUE,
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  ( AS (,
  SELECT AS SELECT,
  emp_id AS emp_id,
  ap AS ap,
  apar_ratings` AS apar_ratings`,
  WHERE fiscal_year IN ("FY26", "2026") AS WHERE fiscal_year IN ("FY26", "2026"),
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  ( AS (,
  SELECT AS SELECT,
  emp_id AS emp_id,
  training_hours AS fy26_training_hours,
  0 AS fy26_training_days,
  0 AS fy26_programmes_completed,
  training_records` AS training_records`,
  WHERE fiscal_year IN ("FY26", "2026") AS WHERE fiscal_year IN ("FY26", "2026"),
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  ( AS (,
  SELECT AS SELECT,
  emp_id AS emp_id,
  gross_earnings_inr AS fy26_gross_salary_inr,
  fy26_basic_pay_inr AS fy26_basic_pay_inr,
  overtime_hours AS fy26_overtime_hours,
  overtime_amount_inr AS fy26_overtime_amount_inr,
  prp_inr AS fy26_prp_inr,
  gross_earnings_inr AS avg_monthly_gross_inr,
  payroll_monthly` AS payroll_monthly`,
  WHERE fiscal_year IN ("FY26", "2026") AS WHERE fiscal_year IN ("FY26", "2026"),
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  ( AS (,
  SELECT AS SELECT,
  emp_id AS emp_id,
  el_balance_days AS el_balance_days,
  el_encashable_days AS el_encashable_days,
  hpl_balance_days AS hpl_balance_days,
  leave_ledger` AS leave_ledger`,
  WHERE fiscal_year IN ("FY26", "2026") AS WHERE fiscal_year IN ("FY26", "2026"),
  GROUP BY emp_id AS GROUP BY emp_id,
  ) AS ),
  SELECT AS SELECT,
  emp_id AS emp_id,
  full_name AS emp_name,
  full_name AS name,
  gender AS gender,
  dob AS dob,
  doj AS doj,
  recruitment_fy AS fiscal_year_joined,
  age_years AS age_years,
  age_band AS age_band,
  station_tenure_continuous_years AS total_tenure_years,
  '<5 years' AS tenure_band,
  social_category AS social_category,
  social_category AS category,
  pwd_flag AS pwd_flag,
  'None' AS pwd_category,
  home_state_code AS home_state_code,
  grade_id AS grade_id,
  grade_id AS current_grade_id,
  cadre AS cadre,
  group_class AS group_class,
  grade_designation AS grade_designation,
  grade_level_order AS grade_level_order,
  discipline_id AS discipline_id,
  discipline_name AS discipline_code,
  discipline_name AS discipline_name,
  function_code AS discipline_function,
  wc_id AS wc_id,
  wc_id AS current_wc_id,
  wc_name AS wc_name,
  wc_name AS wc_short_name,
  city_name AS city,
  state_of_posting AS state,
  'Sector' AS sector,
  basin_id AS cluster_id,
  basin_id AS cluster_name,
  'None' AS hard_station_cat,
  location_type AS onshore_offshore,
  wc_type AS wc_type,
  (wc_id = 'WC-DEL') AS is_corporate_hq,
  functional_designation AS current_designation,
  recruitment_channel AS entry_mode,
  IF(is_month_end_active, 'Active', 'Separated') AS employment_status,
  separation_date AS separation_date,
  CAST(NULL AS DATE) AS retirement_date,
  10.0 AS years_to_retirement,
  FALSE AS is_retiring_within_3yr,
  hard_station_flag AS has_hard_station_tenure,
  offshore_rotation_flag AS has_offshore_tenure,
  'None' AS exemption_tag,
  'None' AS exemption_reason_code,
  CAST(NULL AS DATE) AS continuous_from_date,
  CAST(station_tenure_continuous_years * 12 AS INT64) AS continuous_stay_months,
  station_tenure_continuous_years AS continuous_stay_years,
  (station_tenure_continuous_years > 5) AS is_continuous_5yr_plus,
  FALSE AS is_superannuation_exempt,
  station_tenure_continuous_years AS cumulative_cluster_years,
  FALSE AS has_breached_cluster_10yr_cap,
  apar_score AS fy26_apar_score,
  apar_grade AS fy26_apar_rating,
  dpc_eligible_flag AS is_dpc_eligible,
  training_hours AS fy26_training_hours,
  0 AS fy26_training_days,
  0 AS fy26_programmes_completed,
  gross_earnings_inr AS fy26_gross_salary_inr,
  gross_earnings_inr / 100000 AS fy26_gross_salary_lakh,
  gross_earnings_inr AS avg_monthly_gross_inr,
  overtime_hours AS fy26_overtime_hours,
  overtime_amount_inr AS fy26_overtime_amount_inr,
  prp_inr AS fy26_prp_inr,
  el_balance_days AS el_balance_days,
  el_encashable_days AS el_encashable_days,
  hpl_balance_days AS hpl_balance_days,
  IF(is_month_end_active, 1, 0) AS active_headcount,
  IF(is_month_end_active, 1, 0) AS in_position_strength
FROM ${ref('ssot_employee_360')}
WHERE is_fy_end = TRUE AND fiscal_year = 'FY26'