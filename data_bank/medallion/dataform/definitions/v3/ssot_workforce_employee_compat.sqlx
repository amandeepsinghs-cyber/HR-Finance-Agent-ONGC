config {
  type: "view",
  schema: "hrfin_gold",
  name: "ssot_workforce_employee",
  description: "Compat view projecting FY26 year-end snapshot from ssot_employee_360."
}
SELECT
  emp_id AS emp_id,
  full_name AS emp_name,
  full_name AS name,
  gender AS gender,
  date_of_birth AS dob,
  doj AS doj,
  recruitment_fy AS fiscal_year_joined,
  age_years AS age_years,
  age_band_brsr AS age_band,
  total_service_years AS total_tenure_years,
  CASE
    WHEN total_service_years < 3 THEN '<3yr'
    WHEN total_service_years < 5 THEN '3-5yr'
    WHEN total_service_years <= 10 THEN '5-10yr'
    ELSE '>10yr'
  END AS tenure_band,
  social_category AS social_category,
  social_category AS category,
  pwd_flag AS pwd_flag,
  IF(pwd_flag, 'OH', 'None') AS pwd_category,
  home_state_code AS home_state_code,
  grade_id AS grade_id,
  grade_id AS current_grade_id,
  cadre AS cadre,
  group_class AS group_class,
  grade_designation AS grade_designation,
  grade_level_order AS grade_level_order,
  discipline_id AS discipline_id,
  function_code AS discipline_code,
  discipline_name AS discipline_name,
  function_code AS discipline_function,
  wc_id AS wc_id,
  wc_id AS current_wc_id,
  wc_name AS wc_name,
  wc_name AS wc_short_name,
  city_name AS city,
  state_of_posting AS state,
  asset_id AS sector,
  basin_id AS cluster_id,
  basin_id AS cluster_name,
  IF(hard_station_flag, 'C', 'A') AS hard_station_cat,
  location_type AS onshore_offshore,
  wc_type AS wc_type,
  (wc_id IN ('WC-DEL', 'WC-DDN')) AS is_corporate_hq,
  functional_designation AS current_designation,
  recruitment_channel AS entry_mode,
  IF(is_month_end_active, 'Active', 'Separated') AS employment_status,
  separation_date AS separation_date,
  superannuation_date AS retirement_date,
  years_to_superannuation AS years_to_retirement,
  _3y AS is_retiring_within_3yr,
  hard_station_flag AS has_hard_station_tenure,
  offshore_rotation_flag AS has_offshore_tenure,
  COALESCE(jrtp_exemption_code, 'None') AS exemption_tag,
  COALESCE(jrtp_exemption_code, 'None') AS exemption_reason_code,
  current_station_since AS continuous_from_date,
  CAST(ROUND(station_tenure_continuous_years * 12) AS INT64) AS continuous_stay_months,
  station_tenure_continuous_years AS continuous_stay_years,
  (station_tenure_continuous_years > 5) AS is_continuous_5yr_plus,
  (jrtp_exemption_code = 'PRE_RETIREMENT' OR years_to_superannuation <= 2.0) AS is_superannuation_exempt,
  cluster_tenure_cumulative_years AS cumulative_cluster_years,
  (cluster_tenure_cumulative_years > 10) AS has_breached_cluster_10yr_cap,
  apar_score AS fy26_apar_score,
  apar_grade AS fy26_apar_rating,
  dpc_eligible_flag AS is_dpc_eligible,
  training_hours_fytd AS fy26_training_hours,
  CAST(CEIL(training_hours_fytd / 8.0) AS INT64) AS fy26_training_days,
  IF(training_hours_fytd > 0, 1, 0) AS fy26_programmes_completed,
  gross_earnings_inr * 12 AS fy26_gross_salary_inr,
  (gross_earnings_inr * 12) / 100000 AS fy26_gross_salary_lakh,
  basic_pay_inr * 12 AS fy26_basic_pay_inr,
  gross_earnings_inr AS avg_monthly_gross_inr,
  overtime_hours * 12 AS fy26_overtime_hours,
  overtime_amount_inr * 12 AS fy26_overtime_amount_inr,
  prp_accrual_inr * 12 AS fy26_prp_inr,
  el_balance_days AS el_balance_days,
  el_encashable_days AS el_encashable_days,
  hpl_balance_days AS hpl_balance_days,
  IF(is_month_end_active, 1, 0) AS active_headcount,
  IF(is_month_end_active, 1, 0) AS in_position_strength
FROM ${ref('ssot_employee_360')}
WHERE is_fy_end = TRUE AND fiscal_year = 'FY26'
