config {
  type: "view",
  schema: "hrfin_gold",
  name: "ssot_workforce_employee",
  description: "Compat view projecting FY26 year-end snapshot from ssot_employee_360."
}
SELECT
  e.emp_id AS emp_id,
  e.full_name AS emp_name,
  e.full_name AS name,
  e.gender AS gender,
  e.date_of_birth AS dob,
  e.doj AS doj,
  e.recruitment_fy AS fiscal_year_joined,
  e.age_years AS age_years,
  e.age_band_brsr AS age_band,
  e.total_service_years AS total_tenure_years,
  CASE
    WHEN e.total_service_years < 3 THEN '<3yr'
    WHEN e.total_service_years < 5 THEN '3-5yr'
    WHEN e.total_service_years <= 10 THEN '5-10yr'
    ELSE '>10yr'
  END AS tenure_band,
  e.social_category AS social_category,
  e.social_category AS category,
  e.pwd_flag AS pwd_flag,
  IF(e.pwd_flag, 'OH', 'None') AS pwd_category,
  e.home_state_code AS home_state_code,
  e.grade_id AS grade_id,
  e.grade_id AS current_grade_id,
  e.cadre AS cadre,
  e.group_class AS group_class,
  e.grade_designation AS grade_designation,
  e.grade_level_order AS grade_level_order,
  e.discipline_id AS discipline_id,
  e.function_code AS discipline_code,
  e.discipline_name AS discipline_name,
  e.function_code AS discipline_function,
  e.wc_id AS wc_id,
  e.wc_id AS current_wc_id,
  e.wc_name AS wc_name,
  e.wc_name AS wc_short_name,
  e.city_name AS city,
  e.state_of_posting AS state,
  e.asset_id AS sector,
  e.basin_id AS cluster_id,
  e.basin_id AS cluster_name,
  IF(e.hard_station_flag, 'C', 'A') AS hard_station_cat,
  e.location_type AS onshore_offshore,
  e.wc_type AS wc_type,
  (e.wc_id IN ('WC-DEL', 'WC-DDN')) AS is_corporate_hq,
  e.functional_designation AS current_designation,
  e.recruitment_channel AS entry_mode,
  COALESCE(em.employment_status, IF(e.is_month_end_active, 'Active', 'Separated')) AS employment_status,
  COALESCE(em.separation_date, e.separation_date) AS separation_date,
  e.superannuation_date AS retirement_date,
  e.years_to_superannuation AS years_to_retirement,
  e._3y AS is_retiring_within_3yr,
  e.hard_station_flag AS has_hard_station_tenure,
  e.offshore_rotation_flag AS has_offshore_tenure,
  COALESCE(e.jrtp_exemption_code, 'None') AS exemption_tag,
  COALESCE(e.jrtp_exemption_code, 'None') AS exemption_reason_code,
  COALESCE(cs.continuous_from_date, e.current_station_since) AS continuous_from_date,
  COALESCE(cs.continuous_stay_months, CAST(ROUND(e.station_tenure_continuous_years * 12) AS INT64)) AS continuous_stay_months,
  COALESCE(cs.continuous_stay_years, e.station_tenure_continuous_years) AS continuous_stay_years,
  COALESCE(cs.is_continuous_5yr_plus, (e.station_tenure_continuous_years > 5)) AS is_continuous_5yr_plus,
  (e.jrtp_exemption_code = 'PRE_RETIREMENT' OR e.years_to_superannuation <= 2.0) AS is_superannuation_exempt,
  e.cluster_tenure_cumulative_years AS cumulative_cluster_years,
  (e.cluster_tenure_cumulative_years > 10) AS has_breached_cluster_10yr_cap,
  e.apar_score AS fy26_apar_score,
  e.apar_grade AS fy26_apar_rating,
  e.dpc_eligible_flag AS is_dpc_eligible,
  e.training_hours_fytd AS fy26_training_hours,
  CAST(CEIL(e.training_hours_fytd / 8.0) AS INT64) AS fy26_training_days,
  IF(e.training_hours_fytd > 0, 1, 0) AS fy26_programmes_completed,
  e.gross_earnings_inr * 12 AS fy26_gross_salary_inr,
  (e.gross_earnings_inr * 12) / 100000 AS fy26_gross_salary_lakh,
  e.basic_pay_inr * 12 AS fy26_basic_pay_inr,
  e.gross_earnings_inr AS avg_monthly_gross_inr,
  e.overtime_hours * 12 AS fy26_overtime_hours,
  e.overtime_amount_inr * 12 AS fy26_overtime_amount_inr,
  e.prp_accrual_inr * 12 AS fy26_prp_inr,
  e.el_balance_days AS el_balance_days,
  e.el_encashable_days AS el_encashable_days,
  e.hpl_balance_days AS hpl_balance_days,
  IF(COALESCE(em.employment_status, IF(e.is_month_end_active, 'Active', 'Separated')) = 'Active', 1, 0) AS active_headcount,
  IF(COALESCE(em.employment_status, IF(e.is_month_end_active, 'Active', 'Separated')) = 'Active', 1, 0) AS in_position_strength
FROM ${ref('ssot_employee_360')} e
LEFT JOIN ${ref('employee_master')} em ON e.emp_id = em.emp_id
LEFT JOIN (
  SELECT emp_id, wc_id, continuous_from_date, continuous_stay_months, continuous_stay_years, is_continuous_5yr_plus
  FROM ${ref('v_continuous_stay')}
  WHERE is_current_stay = TRUE
  QUALIFY ROW_NUMBER() OVER (PARTITION BY emp_id ORDER BY continuous_from_date DESC) = 1
) cs ON e.emp_id = cs.emp_id AND e.wc_id = cs.wc_id
WHERE e.month_start = DATE '2026-09-01'
