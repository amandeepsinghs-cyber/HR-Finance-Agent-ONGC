config {
  type: "table",
  schema: "hrfin_stage",
  name: "int_fe_targets_fy",
  description: "Real standalone AR targets per FY x line for Field Economics-360 reconciliation (SPEC-05 §5)"
}

SELECT
  TRIM(fiscal_year) AS fiscal_year,
  TRIM(line_code) AS line_code,
  SAFE_CAST(value AS NUMERIC) AS value,
  TRIM(unit) AS unit,
  TRIM(source_doc) AS source_doc,
  SAFE_CAST(source_page AS INT64) AS source_page,
  SAFE_CAST(source_text_line AS INT64) AS source_text_line,
  SAFE_CAST(verified AS BOOL) AS verified
FROM ${ref(dataform.projectConfig.schemaSuffix ? "hrfin_ref_" + dataform.projectConfig.schemaSuffix : "hrfin_ref", "field_econ_targets_fy")}
WHERE SAFE_CAST(verified AS BOOL) = TRUE
