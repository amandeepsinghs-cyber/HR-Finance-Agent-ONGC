config {
  type: "table",
  schema: "hrfin_silver",
  name: "payroll_monthly",
  description: "Monthly employee payroll ledger detailing basic pay, DA, allowances, overtime, employer pension, and DPE 30% benefit cap."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(`payroll_id`) AS payroll_id,
    TRIM(`PERNR`) AS emp_id,
    TRIM(`FPPER`) AS month,
    TRIM(`fiscal_year`) AS fiscal_year,
    TRIM(`wc_id`) AS wc_id,
    TRIM(`grade_id`) AS grade_id,
    TRIM(`discipline_id`) AS discipline_id,
    TRIM(`cost_centre_id`) AS cost_centre_id,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_1001`), ''), ',', ''), '₹', '') AS NUMERIC) AS basic_pay_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_1002`), ''), ',', ''), '₹', '') AS NUMERIC) AS da_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cafeteria_allowances_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cafeteria_allowances_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hra_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hra_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`mining_offshore_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS mining_offshore_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_hours`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_hours,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_amount_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_amount_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`prp_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS prp_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_cpf_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_cpf_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prbs_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prbs_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prmb_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prmb_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_9001`), ''), ',', ''), '₹', '') AS NUMERIC) AS gross_salary_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`income_tax_tds_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS income_tax_tds_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_9002`), ''), ',', ''), '₹', '') AS NUMERIC) AS net_salary_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`superannuation_benefit_pct`), ''), ',', ''), '₹', '') AS NUMERIC) AS superannuation_benefit_pct
  FROM ${ref("sap_py_cluster_exp")}
  WHERE NULLIF(TRIM(`payroll_id`), '') IS NOT NULL
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY payroll_id ORDER BY _ingest_ts DESC) = 1
