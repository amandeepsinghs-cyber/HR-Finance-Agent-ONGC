config {
  type: "table",
  schema: "hrfin_silver",
  name: "payroll_monthly",
  description: "Monthly employee payroll ledger detailing basic pay, DA, allowances, overtime, employer pension, and DPE 30% benefit cap."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(`payroll_id`) AS payroll_id,
    TRIM(`PERNR`) AS emp_id,
    TRIM(`FPPER`) AS month,
    TRIM(`FPPER`) AS pay_period,
    TRIM(`fiscal_year`) AS fiscal_year,
    TRIM(`wc_id`) AS wc_id,
    TRIM(`grade_id`) AS grade_id,
    TRIM(`discipline_id`) AS discipline_id,
    TRIM(`cost_centre_id`) AS cost_centre_id,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_1001`), ''), ',', ''), '₹', '') AS NUMERIC) AS basic_pay_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_1002`), ''), ',', ''), '₹', '') AS NUMERIC) AS da_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cafeteria_allowances_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cafeteria_allowances_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hra_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hra_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`mining_offshore_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS mining_offshore_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_hours`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_hours,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_amount_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_amount_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`prp_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS prp_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_cpf_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_cpf_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prbs_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prbs_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prmb_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prmb_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_9001`), ''), ',', ''), '₹', '') AS NUMERIC) AS gross_salary_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`income_tax_tds_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS income_tax_tds_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`LGART_9002`), ''), ',', ''), '₹', '') AS NUMERIC) AS net_salary_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`superannuation_benefit_pct`), ''), ',', ''), '₹', '') AS NUMERIC) AS superannuation_benefit_pct,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cafeteria_allowance_inr_base`), ''), ',', ''), '₹', '') AS NUMERIC) AS cafeteria_allowance_inr_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_amount_inr_base`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_amount_inr_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`prp_accrual_inr_base`), ''), ',', ''), '₹', '') AS NUMERIC) AS prp_accrual_inr_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`gratuity_accrual_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS gratuity_accrual_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`leave_provision_accrual_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS leave_provision_accrual_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_cost_noncash_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_cost_noncash_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`medical_scheme_cost_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS medical_scheme_cost_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`group_insurance_premium_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS group_insurance_premium_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`accident_insurance_premium_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS accident_insurance_premium_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`housing_cost_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS housing_cost_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`canteen_subsidy_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS canteen_subsidy_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`transport_subsidy_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS transport_subsidy_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`staff_welfare_alloc_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS staff_welfare_alloc_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`training_cost_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS training_cost_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`csss_contribution_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS csss_contribution_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_expensed_production_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_expensed_production_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`caf_conveyance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS caf_conveyance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`caf_children_edu_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS caf_children_edu_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`caf_professional_dev_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS caf_professional_dev_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`caf_other_perks_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS caf_other_perks_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hardship_offshore_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hardship_offshore_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`field_duty_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS field_duty_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`location_comp_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS location_comp_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hard_station_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hard_station_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`shift_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS shift_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`night_duty_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS night_duty_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`npa_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS npa_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`special_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS special_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`prp_paid_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS prp_paid_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`leave_encashment_paid_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS leave_encashment_paid_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`ltc_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS ltc_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`medical_reimbursement_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS medical_reimbursement_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`ex_gratia_other_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS ex_gratia_other_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employee_pf_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employee_pf_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`vpf_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS vpf_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`professional_tax_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS professional_tax_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hrr_recovery_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hrr_recovery_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`loan_recoveries_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS loan_recoveries_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`other_recoveries_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS other_recoveries_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`capitalised_share`), ''), ',', ''), '₹', '') AS NUMERIC) AS capitalised_share,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_capitalised_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_capitalised_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_expensed_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_expensed_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_expensed_gae_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_expensed_gae_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_expensed_exploration_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_expensed_exploration_inr,
    TRIM(`field_id`) AS field_id,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`fixed_note35a`), ''), ',', ''), '₹', '') AS NUMERIC) AS fixed_note35a,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`adjustable_note35a_base`), ''), ',', ''), '₹', '') AS NUMERIC) AS adjustable_note35a_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_b_base`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_b_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`u_fy`), ''), ',', ''), '₹', '') AS NUMERIC) AS u_fy,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`k_fy`), ''), ',', ''), '₹', '') AS NUMERIC) AS k_fy,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`ot_fy`), ''), ',', ''), '₹', '') AS NUMERIC) AS ot_fy,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`arrears_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS arrears_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_allocated_ew_dd_survey_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_allocated_ew_dd_survey_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_expensed_pnl_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_expensed_pnl_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_a_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_a_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_b_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_b_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_c_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_c_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_d_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_d_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_e_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_e_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cost_note35_f_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cost_note35_f_inr
  FROM ${ref("sap_py_cluster_exp")}
  WHERE NULLIF(TRIM(`payroll_id`), '') IS NOT NULL
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY payroll_id ORDER BY _ingest_ts DESC) = 1
