config {
  type: "table",
  schema: "hrfin_silver",
  name: "payroll_monthly",
  description: "Monthly employee payroll ledger detailing basic pay, DA, allowances, overtime, employer pension, and DPE 30% benefit cap."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(`PERNR`) AS PERNR,
    TRIM(`FPPER`) AS FPPER,
    TRIM(`fiscal_year`) AS fiscal_year,
    TRIM(`wc_id`) AS wc_id,
    TRIM(`grade_id`) AS grade_id,
    TRIM(`discipline_id`) AS discipline_id,
    TRIM(`cost_centre_id`) AS cost_centre_id,
    TRIM(`LGART_1001`) AS LGART_1001,
    TRIM(`LGART_1002`) AS LGART_1002,
    TRIM(`cafeteria_allowance_inr_base`) AS cafeteria_allowance_inr_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`hra_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS hra_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`mining_offshore_allowance_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS mining_offshore_allowance_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_hours`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_hours,
    TRIM(`overtime_amount_inr_base`) AS overtime_amount_inr_base,
    TRIM(`prp_accrual_inr_base`) AS prp_accrual_inr_base,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_cpf_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_cpf_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prbs_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prbs_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`employer_prmb_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS employer_prmb_inr,
    TRIM(`gratuity_accrual_inr`) AS gratuity_accrual_inr,
    TRIM(`leave_provision_accrual_inr`) AS leave_provision_accrual_inr,
    TRIM(`employer_cost_noncash_inr`) AS employer_cost_noncash_inr,
    TRIM(`medical_scheme_cost_inr`) AS medical_scheme_cost_inr,
    TRIM(`group_insurance_premium_inr`) AS group_insurance_premium_inr,
    TRIM(`accident_insurance_premium_inr`) AS accident_insurance_premium_inr,
    TRIM(`housing_cost_inr`) AS housing_cost_inr,
    TRIM(`canteen_subsidy_inr`) AS canteen_subsidy_inr,
    TRIM(`transport_subsidy_inr`) AS transport_subsidy_inr,
    TRIM(`staff_welfare_alloc_inr`) AS staff_welfare_alloc_inr,
    TRIM(`training_cost_inr`) AS training_cost_inr,
    TRIM(`csss_contribution_inr`) AS csss_contribution_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`income_tax_tds_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS income_tax_tds_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`superannuation_benefit_pct`), ''), ',', ''), '₹', '') AS NUMERIC) AS superannuation_benefit_pct,
    TRIM(`cost_expensed_production_inr`) AS cost_expensed_production_inr,
    TRIM(`fixed_note35a`) AS fixed_note35a,
    TRIM(`adjustable_note35a_base`) AS adjustable_note35a_base,
    TRIM(`u_fy`) AS u_fy,
    TRIM(`k_fy`) AS k_fy,
    TRIM(`ot_fy`) AS ot_fy,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`cafeteria_allowances_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS cafeteria_allowances_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`overtime_amount_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS overtime_amount_inr,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`prp_inr`), ''), ',', ''), '₹', '') AS NUMERIC) AS prp_inr,
    TRIM(`arrears_inr`) AS arrears_inr,
    TRIM(`LGART_9001`) AS LGART_9001,
    TRIM(`LGART_9002`) AS LGART_9002,
    TRIM(`payroll_id`) AS payroll_id,
    TRIM(`cost_note35_a_inr`) AS cost_note35_a_inr,
    TRIM(`cost_note35_b_inr`) AS cost_note35_b_inr,
    TRIM(`cost_note35_c_inr`) AS cost_note35_c_inr,
    TRIM(`cost_note35_d_inr`) AS cost_note35_d_inr,
    TRIM(`cost_note35_e_inr`) AS cost_note35_e_inr,
    TRIM(`cost_note35_f_inr`) AS cost_note35_f_inr
  FROM ${ref("sap_py_cluster_exp")}
  WHERE NULLIF(TRIM(`payroll_id`), '') IS NOT NULL
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY payroll_id ORDER BY _ingest_ts DESC) = 1
