config {
  type: "table",
  schema: "hrfin_silver",
  name: "board_agenda_index",
  description: "Index of ONGC Board of Directors meeting agenda items, confidential board notes, resolutions, and sponsors."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(col_0) AS agenda_id,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_1), ''), ',', ''), '₹', '') AS INT64) AS meeting_number,
    SAFE.PARSE_DATE('%Y-%m-%d', SUBSTR(NULLIF(TRIM(col_2), ''), 1, 10)) AS meeting_date,
    TRIM(col_3) AS fiscal_year,
    TRIM(col_4) AS item_number,
    TRIM(col_5) AS director_sponsor,
    TRIM(col_6) AS subject_title,
    TRIM(col_7) AS agenda_category,
    TRIM(col_8) AS confidentiality_level,
    TRIM(col_9) AS key_recommendations,
    TRIM(col_10) AS resolution_status,
    TRIM(col_11) AS document_ref_id
  FROM ${ref("excel_board_agenda_index")}
  WHERE _row_number >= 2 AND col_0 IS NOT NULL AND TRIM(col_0) != '' AND _sheet_name NOT IN ('Notes_and_Citations', 'Executive_Summary', '_Ref_Capex_Codes', '_Cadre_Control_Master', '_MoU_Grading_Rules', '_Schedule_VII_Themes', '_Talent_Bench_Scale', '_Court_Jurisdiction_Codes')
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY agenda_id ORDER BY _ingest_ts DESC) = 1
