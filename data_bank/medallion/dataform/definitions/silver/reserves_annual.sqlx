config {
  type: "table",
  schema: "hrfin_silver",
  name: "reserves_annual",
  description: "Annual hydrocarbon reserves statement detailing 1P/2P in-place volumes, accretion, and Reserve Replacement Ratio (RRR)."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(col_0) AS reserve_id,
    TRIM(col_1) AS fiscal_year,
    TRIM(col_2) AS field_id,
    TRIM(col_3) AS asset_wc_id,
    TRIM(col_4) AS basin_name,
    TRIM(col_5) AS onshore_offshore,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_6), ''), ',', ''), '₹', '') AS NUMERIC) AS inplace_oil_mmt,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_7), ''), ',', ''), '₹', '') AS NUMERIC) AS inplace_gas_bcm,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_8), ''), ',', ''), '₹', '') AS NUMERIC) AS inplace_total_mmtoe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_9), ''), ',', ''), '₹', '') AS NUMERIC) AS reserves_1p_mmtoe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_10), ''), ',', ''), '₹', '') AS NUMERIC) AS reserves_2p_oil_mmt,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_11), ''), ',', ''), '₹', '') AS NUMERIC) AS reserves_2p_gas_bcm,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_12), ''), ',', ''), '₹', '') AS NUMERIC) AS reserves_2p_total_mmtoe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_13), ''), ',', ''), '₹', '') AS NUMERIC) AS annual_production_mmtoe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_14), ''), ',', ''), '₹', '') AS NUMERIC) AS gross_reserves_accretion_mmtoe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_15), ''), ',', ''), '₹', '') AS NUMERIC) AS reserve_replacement_ratio_rrr_2p,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_16), ''), ',', ''), '₹', '') AS NUMERIC) AS finding_cost_usd_per_boe,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(col_17), ''), ',', ''), '₹', '') AS NUMERIC) AS development_cost_usd_per_boe
  FROM ${ref("excel_reserves_annual")}
  WHERE _row_number >= 2 AND col_0 IS NOT NULL AND TRIM(col_0) != '' AND _sheet_name NOT IN ('Notes_and_Citations', 'Executive_Summary', '_Ref_Capex_Codes', '_Cadre_Control_Master', '_MoU_Grading_Rules', '_Schedule_VII_Themes', '_Talent_Bench_Scale', '_Court_Jurisdiction_Codes')
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY reserve_id ORDER BY _ingest_ts DESC) = 1
