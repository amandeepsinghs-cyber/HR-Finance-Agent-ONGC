config {
  type: "table",
  schema: "hrfin_silver",
  name: "separations",
  description: "Comprehensive separation register tracking superannuation, VRS, resignations, and attrition root causes."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(`separation_id`) AS separation_id,
    TRIM(`PERNR`) AS PERNR,
    TRIM(`BEGDA`) AS BEGDA,
    TRIM(`fiscal_year`) AS fiscal_year,
    TRIM(`MASSN`) AS MASSN,
    TRIM(`last_grade_id`) AS last_grade_id,
    TRIM(`discipline_id`) AS discipline_id,
    TRIM(`last_wc_id`) AS last_wc_id,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`age_at_separation`), ''), ',', ''), '₹', '') AS NUMERIC) AS age_at_separation,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`total_service_years`), ''), ',', ''), '₹', '') AS NUMERIC) AS total_service_years,
    TRIM(`MASSG`) AS MASSG,
    TRIM(`target_company_or_sector`) AS target_company_or_sector
  FROM ${ref("sap_pa0000_separations")}
  WHERE NULLIF(TRIM(`separation_id`), '') IS NOT NULL
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY separation_id ORDER BY _ingest_ts DESC) = 1
