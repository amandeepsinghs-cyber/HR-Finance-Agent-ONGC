config {
  type: "table",
  schema: "hrfin_silver",
  name: "leave_ledger",
  description: "Employee leave balance and transaction ledger tracking Earned Leave (EL), Casual Leave (CL), Half Pay Leave (HPL), and encashment."
}

WITH raw AS (
  SELECT
    _ingest_ts,
    TRIM(`PERNR`) AS PERNR,
    TRIM(`wc_id`) AS wc_id,
    TRIM(`fiscal_year`) AS fiscal_year,
    TRIM(`SUBTY`) AS SUBTY,
    TRIM(`transaction_type`) AS transaction_type,
    TRIM(`BEGDA`) AS BEGDA,
    TRIM(`ENDDA`) AS ENDDA,
    TRIM(`ABWTG`) AS ABWTG,
    TRIM(`ANZHL`) AS ANZHL,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`encashable_balance_days`), ''), ',', ''), '₹', '') AS NUMERIC) AS encashable_balance_days,
    SAFE_CAST(REPLACE(REPLACE(NULLIF(TRIM(`study_leave_bond_years`), ''), ',', ''), '₹', '') AS INT64) AS study_leave_bond_years,
    TRIM(`leave_id`) AS leave_id
  FROM ${ref("sap_pa2001_pa2006")}
  WHERE NULLIF(TRIM(`leave_id`), '') IS NOT NULL
)
SELECT * EXCEPT(_ingest_ts)
FROM raw
QUALIFY ROW_NUMBER() OVER (PARTITION BY leave_id ORDER BY _ingest_ts DESC) = 1
