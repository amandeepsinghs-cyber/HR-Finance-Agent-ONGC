config {
  type: "assertion",
  schema: "hrfin_silver",
  description: "Assert that dim_grade group is non-null and valid for all grades"
}

SELECT
  grade_id,
  cadre,
  `group`
FROM ${ref(dataform.projectConfig.schemaSuffix ? "hrfin_silver_" + dataform.projectConfig.schemaSuffix : "hrfin_silver", "dim_grade")}
WHERE `group` IS NULL OR TRIM(`group`) = ''
